<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sets the unit's screen brightness. The user grants it from Cabin's Settings. -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        xmlns:tools="http://schemas.android.com/tools"
        tools:ignore="ProtectedPermissions" />
    <!-- Only the last position Android already has, to work out sunrise and sunset for Auto brightness. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- The Wi-Fi and phone marks beside the clock, which only read state. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />

    <!--
        The tray's Bluetooth and Wi-Fi switches. Android 13 answers "no" to both for an app like
        Cabin, which then opens the unit's own switch; an older or more lenient unit lets them work.
        Bluetooth needs the first only before Android 12, and "nearby devices" above from then on.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- The tray's Clear memory: closes what other apps have left running in the background. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- "Where to?" listens for one spoken destination. Asked for the first time it is used. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- A launcher has to see every launchable app, and "Where to?" the unit's speech recogniser. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".CabinApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Cabin">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection|mcc|mnc"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The chooser for a second app, which the side bar's Split button opens in half the screen
            beside the app that was in front. It is a task of its own, and it goes as soon as an app is
            chosen or it is left.
        -->
        <activity
            android:name=".ui.split.SplitChooserActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection|mcc|mnc"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:resizeableActivity="true"
            android:taskAffinity="com.roufsyed.cabin.split"
            android:windowSoftInputMode="adjustNothing" />

        <!-- Bound by Android once notification access is granted. It is how Cabin sees what is playing. -->
        <service
            android:name=".notify.CabinNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            Bound by Android once Cabin is switched on under Accessibility. It keeps the rail on screen
            over other apps and presses Back in them, which Android lets no other kind of app do. What
            it asks to be told is in res/xml/side_bar_service.xml.
        -->
        <service
            android:name=".bar.SideBarService"
            android:exported="true"
            android:label="@string/side_bar_service"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/side_bar_service" />
        </service>
    </application>

</manifest>
